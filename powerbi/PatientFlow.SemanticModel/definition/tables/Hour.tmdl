table Hour

	column hour
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: hour

	column hour_label
		dataType: string
		summarizeBy: none
		sourceColumn: hour_label

	column shift
		dataType: string
		summarizeBy: none
		sourceColumn: shift

	partition Hour = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_hour.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Typed columns" = Table.TransformColumnTypes(
				        #"Promoted headers",
				        {
						{"hour", Int64.Type},
						{"hour_label", type text},
						{"shift", type text}
				        },
				        "en-US"
				    )
				in
				    #"Typed columns"
